<Window x:Class="WorkTimer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作计时"
        Height="800" Width="1060" MinHeight="660" MinWidth="920"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- ================================================= 顶部：计时与实时判定 -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="20,16,20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 状态 + 项目选择 -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StateDot" Grid.Column="0" Width="12" Height="12"
                             VerticalAlignment="Center" Margin="0,0,8,0"
                             Fill="{StaticResource StateStoppedBrush}" />
                    <TextBlock x:Name="StateText" Grid.Column="1" Text="未开始"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="项目" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" />
                        <ComboBox x:Name="ProjectCombo" Width="220"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="OnProjectSelectionChanged" />
                        <Button Content="新建" Style="{StaticResource FlatButton}"
                                Margin="8,0,0,0" Padding="10,6" Click="OnCreateProject"
                                ToolTip="新建一个项目。默认名是「项目+今天日期」，重名会被拦下。" />
                        <Button Content="重命名" Style="{StaticResource FlatButton}"
                                Margin="8,0,0,0" Padding="10,6" Click="OnRenameProject" />
                    </StackPanel>
                </Grid>

                <!-- 主计时器 -->
                <TextBlock x:Name="TimerText" Grid.Row="1" Text="00:00:00"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="52" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,4,0,2" />

                <!-- 副计时 -->
                <TextBlock x:Name="SubTimerText" Grid.Row="2"
                           Text="待判定 00:00:00 · 挂起 00:00:00 · 暂停 00:00:00 · 空闲 00:00:00"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,12" />

                <!-- 操作按钮 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Button x:Name="StartButton" Content="开始计时" Style="{StaticResource PrimaryButton}"
                            MinWidth="118" Click="OnStartOrResume" />
                    <Button x:Name="PauseButton" Content="暂停" Style="{StaticResource FlatButton}"
                            MinWidth="98" Margin="10,0,0,0" Click="OnTogglePause" />
                    <Button x:Name="StopButton" Content="停止并保存" Style="{StaticResource FlatButton}"
                            MinWidth="118" Margin="10,0,0,0" Click="OnStop" />
                </StackPanel>

                <!-- 当前判定卡 -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ForegroundText" Text="前台：等待第一次采样…"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="VerdictText" Text="判定：—"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="RunText" Text="娱乐连续：当前无娱乐窗口在前台"
                                       Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                            <ProgressBar x:Name="RunProgress" Height="4" Margin="0,6,0,0"
                                         Minimum="0" Maximum="1000" Value="0"
                                         Background="{StaticResource BgSunkenBrush}"
                                         Foreground="{StaticResource StatePendingBrush}"
                                         BorderThickness="0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Content="改为工作" Style="{StaticResource FlatButton}"
                                    Padding="12,6" Click="OnMarkAsWork" />
                            <Button Content="改为娱乐" Style="{StaticResource FlatButton}"
                                    Padding="12,6" Margin="8,0,0,0" Click="OnMarkAsEntertainment" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================================================= 底部状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource BgAltBrush}"
                   BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource TextMutedBrush}" />
            </StatusBarItem>
        </StatusBar>

        <!-- ================================================= 主体页签 -->
        <TabControl x:Name="Tabs" Margin="14,10,14,10" Background="Transparent" BorderThickness="0">

            <!-- ======================================== 概览 -->
            <TabItem Header="概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,14,4,4">
                    <StackPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="日期范围" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" />
                            <ComboBox x:Name="RangeCombo" Grid.Column="1" Width="150"
                                      SelectionChanged="OnRangeChanged" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <DatePicker x:Name="RangeFrom" Width="140" Visibility="Collapsed" />
                                <DatePicker x:Name="RangeTo" Width="140" Margin="8,0,0,0" Visibility="Collapsed" />
                                <Button Content="刷新" Style="{StaticResource FlatButton}" Margin="8,0,0,0"
                                        Padding="12,6" Click="OnRefreshStats" />
                                <Button Content="导出 CSV" Style="{StaticResource FlatButton}" Margin="8,0,0,0"
                                        Padding="12,6" Click="OnExportCsv" />
                            </StackPanel>
                        </Grid>

                        <!-- 空数据提示条：数据没丢，只是当前范围里没有。
                             默认折叠，由 RefreshStats 根据查询结果决定是否显示。 -->
                        <Border x:Name="OverviewHintBar" Style="{StaticResource Card}" Padding="12,8"
                                Margin="0,6,0,6" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OverviewHintText" Grid.Column="0"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                    <Button Content="最近 7 天" Style="{StaticResource FlatButton}"
                                            Padding="10,5" Click="OnJumpRecent7" />
                                    <Button Content="全部时间" Style="{StaticResource FlatButton}"
                                            Padding="10,5" Margin="8,0,0,0" Click="OnJumpAllTime" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Rows="1" Columns="4" Margin="0,8,0,14">
                            <Border Style="{StaticResource MetricCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="有效工时" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="MetricNet" Text="—" FontSize="24" FontWeight="SemiBold"
                                               FontFamily="{StaticResource MonoFont}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCard}" Margin="6,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="娱乐挂起" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="MetricSuspended" Text="—" FontSize="24" FontWeight="SemiBold"
                                               FontFamily="{StaticResource MonoFont}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCard}" Margin="6,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="摸鱼占比" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="MetricRatio" Text="—" FontSize="24" FontWeight="SemiBold"
                                               FontFamily="{StaticResource MonoFont}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCard}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="会话数" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="MetricSessions" Text="—" FontSize="24" FontWeight="SemiBold"
                                               FontFamily="{StaticResource MonoFont}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="按项目分布" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <DataGrid x:Name="ProjectGrid" Height="200" Margin="0,0,0,16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="项目" Binding="{Binding ProjectName}" Width="2*" />
                                <DataGridTextColumn Header="有效工时" Binding="{Binding NetText}" Width="*" />
                                <DataGridTextColumn Header="占比" Binding="{Binding RatioText}" Width="*" />
                                <DataGridTextColumn Header="挂起" Binding="{Binding SuspendedText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="按天明细" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <DataGrid x:Name="DayGrid" Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="日期" Binding="{Binding Day}" Width="*" />
                                <DataGridTextColumn Header="有效工时" Binding="{Binding NetText}" Width="*" />
                                <DataGridTextColumn Header="挂起" Binding="{Binding SuspendedText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================== 记录 -->
            <TabItem Header="记录">
                <DockPanel Margin="4,14,4,4">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="日期" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" />
                        <DatePicker x:Name="RecordDate" Grid.Column="1" Width="150"
                                    SelectedDateChanged="OnRecordDateChanged" />
                        <Button Grid.Column="2" Content="今天" Style="{StaticResource FlatButton}"
                                Margin="8,0,0,0" Padding="12,6" Click="OnRecordToday" />
                        <Button Grid.Column="3" Content="重新载入" Style="{StaticResource FlatButton}"
                                Margin="8,0,0,0" Padding="12,6" Click="OnReloadSegments" />
                        <Button Grid.Column="4" Content="最近有记录的一天" Style="{StaticResource FlatButton}"
                                Margin="8,0,0,0" Padding="12,6" Click="OnJumpToLatestSegmentDay"
                                ToolTip="直接跳到最近一次真正有明细的日期 —— 今天还没记录时不用自己去翻日历。" />
                        <TextBlock Grid.Column="5" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="14,0,0,0"
                                   Text="明细已按窗口切换自动整合；浏览器按隐私设置只记站点平台名。" />
                    </Grid>

                    <!-- 空数据提示条，由 RefreshSegments 决定是否显示 -->
                    <Border x:Name="RecordHintBar" DockPanel.Dock="Top" Style="{StaticResource Card}"
                            Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RecordHintText" Grid.Column="0"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <Button x:Name="RecordJumpButton" Grid.Column="1" Content="跳到那天"
                                    Style="{StaticResource FlatButton}" Padding="10,5" Margin="12,0,0,0"
                                    Click="OnJumpToLatestSegmentDay" />
                        </Grid>
                    </Border>

                    <DataGrid x:Name="SegmentGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间段" Binding="{Binding Range}" Width="1.6*" />
                            <DataGridTextColumn Header="时长" Binding="{Binding Duration}" Width="0.8*" />
                            <DataGridTextColumn Header="应用 / 站点" Binding="{Binding AppName}" Width="1.8*" />
                            <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="0.7*" />
                            <DataGridTextColumn Header="是否计入" Binding="{Binding Counted}" Width="0.9*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ======================================== 诊断 -->
            <TabItem Header="诊断">
                <Grid Margin="4,14,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" MinWidth="320" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="刷新" Style="{StaticResource FlatButton}" Padding="12,6" Click="OnRefreshDiagnostics" />
                        <Button Content="立即采样一次" Style="{StaticResource FlatButton}" Padding="12,6"
                                Margin="8,0,0,0" Click="OnForceSample" />
                        <Button Content="打开日志目录" Style="{StaticResource FlatButton}" Padding="12,6"
                                Margin="8,0,0,0" Click="OnOpenLogDir" />
                        <Button Content="打开数据目录" Style="{StaticResource FlatButton}" Padding="12,6"
                                Margin="8,0,0,0" Click="OnOpenDataDir" />
                        <Button Content="复制诊断信息" Style="{StaticResource FlatButton}" Padding="12,6"
                                Margin="8,0,0,0" Click="OnCopyDiagnostics" />
                    </StackPanel>

                    <DataGrid x:Name="DiagnosticsGrid" Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="项" Binding="{Binding Key}" Width="1.1*" />
                            <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="1.9*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="运行日志（最近 300 条，新的在下面）"
                                   Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <ListBox x:Name="LogList" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                 Background="{StaticResource BgAltBrush}"
                                 BorderBrush="{StaticResource BorderBrushSoft}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>

                    <TextBlock x:Name="DataDirText" Grid.Row="2" Grid.ColumnSpan="2"
                               Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
                </Grid>
            </TabItem>

            <!-- ======================================== 设置 -->
            <TabItem Header="设置">
                <Grid Margin="4,14,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="SettingsNav" Grid.Column="0" Style="{StaticResource NavList}"
                             SelectionChanged="OnSettingsGroupChanged" Margin="0,0,12,0" />

                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock x:Name="SettingsGroupTitle" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <TextBlock x:Name="SettingsGroupHint" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Padding="16,7"
                                    Click="OnSaveSettings" />
                            <Button Content="打开配置文件" Style="{StaticResource FlatButton}" Padding="14,7"
                                    Margin="8,0,0,0" Click="OnOpenConfigFile" />
                            <TextBlock x:Name="SettingsSaveHint" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <StackPanel x:Name="SettingsContent" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
