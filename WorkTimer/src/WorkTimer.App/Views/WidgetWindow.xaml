<Window x:Class="WorkTimer.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">

    <Border x:Name="Root"
            CornerRadius="12"
            Background="#FFFFFF"
            BorderBrush="#D5D4CE"
            BorderThickness="1">
        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左边一条状态色，收起状态下也能一眼看出是计时中还是已挂起 -->
            <Border x:Name="StateBar" Grid.Column="0" Background="#B4B2A9" CornerRadius="11,0,0,11" />

            <!-- 展开形态 -->
            <Grid x:Name="ExpandedRoot" Grid.Column="1" Margin="12,9,10,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#B4B2A9" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProjectText" Text="未选择项目" Margin="6,0,0,0"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock x:Name="TimeText" Grid.Row="1" Grid.Column="0" Text="00:00:00"
                           FontFamily="{StaticResource MonoFont}" FontSize="21" FontWeight="Bold"
                           Margin="0,1,0,0" VerticalAlignment="Center" />

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                            Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="ToggleButton" Content="开始" Style="{StaticResource FlatButton}"
                            MinWidth="46" Padding="8,4" FontSize="11" Click="OnToggleTimer" />
                    <Button x:Name="StopButton" Content="停止" Style="{StaticResource FlatButton}"
                            MinWidth="42" Padding="8,4" FontSize="11" Margin="6,0,0,0" Click="OnStopTimer" />
                </StackPanel>
            </Grid>

            <!-- 收起形态（贴边后） -->
            <Grid x:Name="CollapsedRoot" Grid.Column="1" Margin="12,0,12,0"
                  VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="DotSmall" Grid.Column="0" Width="9" Height="9" Fill="#B4B2A9"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="ProjectTextSmall" Grid.Column="1" Text="" Margin="6,0,0,0"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="TimeTextSmall" Grid.Column="2" Text="00:00:00"
                           FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="Bold"
                           Margin="6,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
